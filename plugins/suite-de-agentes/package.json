{
  "name": "opencode-agent-suite",
  "version": "1.1.0",
  "description": "Named agent suites, model profiles, and per-turn consent controls for OpenCode",
  "type": "module",
  "main": "./src/server/index.ts",
  "exports": {
    ".": {
      "import": "./src/server/index.ts"
    },
    "./server": {
      "import": "./src/server/index.ts"
    },
    "./tui": {
      "import": "./src/tui/index.tsx"
    },
    "./core": {
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "install.ps1",
    "install.sh",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.5",
    "@opencode/plugin": "2.0.21",
    "@opentui/core": ">=0.5.14 <1",
    "@opentui/keymap": ">=0.5.14 <1",
    "@opentui/solid": ">=0.5.14 <1",
    "solid-js": ">=1.9.15 <2"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.5"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.5",
    "@opencode/plugin": "2.0.21",
    "@opentui/core": "0.5.14",
    "@opentui/keymap": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@types/babel__core": "^7.20.5",
    "@types/node": "25.7.0",
    "esbuild-plugin-solid": "0.6.0",
    "solid-js": "1.9.15",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "overrides": {
    "@opentui/keymap": {
      "solid-js": "$solid-js"
    },
    "@opentui/solid": {
      "solid-js": "$solid-js"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "opencode": ">=1.18.5"
  },
  "license": "MIT"
}
